# API base path. In dev, Vite proxies /api to VITE_BACKEND_URL.
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:3000

# Public base URL of the SPA, used to build shareable invitation links that are
# opened on other devices (WhatsApp, etc). Set this to the public address in any
# deployment; when unset it falls back to the browser's current origin, which is
# correct for local dev (http://localhost:8080) but not for a shared link.
# VITE_APP_BASE_URL=https://app.example.com
