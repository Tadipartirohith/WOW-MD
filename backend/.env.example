# =============================================================================
# WOW Backend, Environment Configuration
# -----------------------------------------------------------------------------
# Copy to `.env` and adjust. Operators/testers change values HERE, never in code.
# The app validates these at boot (src/config/config.schema.ts) and fails fast
# if a required value is missing or malformed. In production, JWT secrets must be
# real (>=32 chars), the app refuses to start otherwise.
# =============================================================================

# ---- Runtime ----
NODE_ENV=development            # development | test | staging | production
PORT=3000
API_PREFIX=api
LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace
CORS_ORIGINS=http://localhost:5173   # comma-separated allow-list
SWAGGER_ENABLED=true

# ---- Database (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=wow_user
DB_PASSWORD=wow_password
DB_NAME=wow_db
DB_SSL=false
DB_POOL_SIZE=10
DB_LOGGING=false

# ---- Redis (cache / sessions / rate-limit / Socket.io adapter) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DEFAULT_TTL=300           # seconds

# ---- Auth ----
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
OTP_TTL_SECONDS=300

# ---- Refresh-token cookie ----
# Refresh tokens ride in an httpOnly cookie so page script cannot read them.
REFRESH_COOKIE_NAME=wow_rt
COOKIE_SECURE=false            # MUST be true anywhere served over TLS
COOKIE_SAME_SITE=lax           # lax | strict | none
COOKIE_DOMAIN=

# ---- Brute-force protection ----
MAX_FAILED_LOGINS=8
LOCKOUT_MINUTES=15

# ---- Single-use email tokens ----
INVITATION_TTL_HOURS=168       # profile invitations (7 days)
EMAIL_VERIFY_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30
RSVP_TOKEN_TTL_DAYS=120        # guest RSVP links

# ---- Two-factor ----
MFA_ISSUER=WOW Weddings
MFA_REQUIRED_FOR_ADMIN=true    # admins can release escrow, so 2FA is not optional

# ---- Mail (invitations, verification, reset, RSVP) ----
MAIL_PROVIDER=log              # log | smtp. 'log' prints the action link, no SMTP needed
MAIL_FROM=WOW <no-reply@wow.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
APP_BASE_URL=http://localhost:8080   # where the links in emails point (the SPA)

# ---- SMS (invitations, phone verification, milestone reminders) ----
# Intake is phone-first: an agent can take on a family who give a number and no
# email at all, so this is often the only channel that reaches them.
SMS_PROVIDER=log               # log | http. 'log' prints the message, no gateway needed
SMS_URL=                       # your gateway's send endpoint (MSG91, Textlocal, Gupshup, …)
SMS_API_KEY=
SMS_SENDER_ID=WOWMAT
SMS_TEMPLATE_ID=               # most Indian gateways require a registered DLT template
SMS_TIMEOUT_MS=8000
PHONE_VERIFY_TTL_MINUTES=10

# ---- Calling (WebRTC) ----
# Only signalling runs on our server; the audio goes browser to browser, which
# is what makes calling affordable. Public STUN covers most networks. A
# symmetric NAT on either side needs a TURN relay, which costs money because it
# does carry the audio — set these when you are ready to pay for that tail.
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Stewardship (agents / family managing other people's profiles) ----
REQUIRE_AGENT_APPROVAL=true    # an agent must be vetted before onboarding anyone
MAX_MANAGED_PROFILES=200       # per agent
MAX_MANAGED_PROFILES_FAMILY=5  # per family account
MAX_INVITATION_RESENDS=5
POOL_QUOTA_PER_AGENCY=50       # the shared network pool is a common resource

# ---- Security / rate limiting ----
RATE_LIMIT_TTL=60               # window (seconds)
RATE_LIMIT_MAX=120              # requests per window per IP (global)
AUTH_RATE_LIMIT_MAX=10          # requests per window on auth endpoints

# ---- Pagination ----
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# ---- Matchmaking compatibility engine (business tunables) ----
# Weights are relative; the engine normalises them to a 0-100 score.
MATCH_WEIGHT_AGE=20
MATCH_WEIGHT_LOCATION=20
MATCH_WEIGHT_RELIGION=20
MATCH_WEIGHT_EDUCATION=15
MATCH_WEIGHT_LIFESTYLE=15
MATCH_WEIGHT_PREFERENCES=10
MATCH_MAX_AGE_GAP=8             # years; beyond this, age score = 0
MATCH_MIN_SCORE=40             # suggestions below this are hidden
MATCH_SUGGESTIONS_CACHE_TTL=120
MATCH_MAX_SUGGESTIONS=50

# ---- Media (S3 + CDN) ----
CDN_BASE_URL=
S3_BUCKET=
S3_REGION=
MAX_FILE_SIZE=10485760          # 10 MB
MEDIA_STORAGE_PROVIDER=mock     # mock | s3
MEDIA_SHARE_BASE_URL=http://localhost:5173/album
S3_ACCESS_KEY_ID=               # required when MEDIA_STORAGE_PROVIDER=s3
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_EXPIRY=900           # seconds a presigned upload URL stays valid

# ---- Payments / escrow ----
PAYMENT_PROVIDER=mock           # mock | razorpay
PAYMENT_CURRENCY=INR
PAYMENT_COMMISSION_PERCENT=10   # marketplace commission on each booking
PAYMENT_WEBHOOK_SECRET=         # HMAC secret the gateway signs webhooks with
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- AI (WOW Genie) ----
AI_PROVIDER=mock                # mock | openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# ---- Neo4j graph matchmaking (optional) ----
NEO4J_ENABLED=false             # true to use graph traversal for suggestions
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=wow_password

# ---- Kafka event streaming (optional) ----
KAFKA_ENABLED=false             # true to also publish domain events to Kafka
KAFKA_BROKERS=localhost:9092    # comma-separated
KAFKA_CLIENT_ID=wow-backend
KAFKA_TOPIC=wow.domain-events
