# Copy to docker/.env and fill in. Compose reads this automatically.
# Never commit the real docker/.env.

# Host ports. Change these if something else already uses them locally.
FRONTEND_PORT=8080
BACKEND_PORT=3000
DB_PORT_HOST=5432
REDIS_PORT_HOST=6379

DB_USER=wow_user
DB_PASSWORD=change-me-strong-db-password
DB_NAME=wow_db

# Must be at least 32 characters. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-in-production-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-in-production-min-32-chars

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080   # must match FRONTEND_PORT

# Bootstrap administrator. ADMIN accounts cannot be created through the public
# API, so seed the first one with:
#   docker compose -f docker/docker-compose.yml --profile seed run --rm seed-admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-12-characters
