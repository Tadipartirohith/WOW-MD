# ---------- build ----------
FROM node:20-alpine AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# VITE_API_URL defaults to /api (same-origin; nginx proxies to the backend).
RUN npm run build

# ---------- serve ----------
FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/dist /usr/share/nginx/html
# nginx.conf lives in the frontend build context (see frontend/nginx.conf).
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
# 127.0.0.1 rather than localhost: nginx listens on IPv4 only, while `localhost`
# resolves to ::1 first inside the container, so the probe was refused and the
# container reported unhealthy while actually serving fine.
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
  CMD wget -qO- http://127.0.0.1/ > /dev/null 2>&1 || exit 1
